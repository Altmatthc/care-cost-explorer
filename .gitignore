# Local environment — never commit this
.venv/
venv/
env/

__pycache__/
*.pyc
*.pyo
.DS_Store
.idea/
.vscode/

# Sharded intermediates; merge_shards consolidates then removes them
data/*-prices-*.json

# Catalogue shards are generated; keep them, but never commit partials

# Intermediate working file. It holds the raw per-hospital catalogue and can
# reach hundreds of megabytes — past GitHub's 100MB per-file limit. It is
# regenerated by every prices run and is only needed locally, for deciding
# which hospitals to skip. The published data lives in <region>.json,
# <region>-codes/ and <region>-search.json, which ARE committed.
data/*-prices.json
data/file-cache.json

# Per-hospital catalogue working files. Merged into the code buckets, then
# only needed for the next merge. Local only.
data/*-catalogue/
data/.release-manifest-*.json
data/.release-staging/
